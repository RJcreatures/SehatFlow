# Copy this file to .env and fill it only on your machine.
# Never commit .env. Never put a service_role key, secret key, or database password here.

# Supabase project URL root only, such as https://your-project.supabase.co
# Do not include /rest/v1. For a local stack this is http://127.0.0.1:54321
VITE_SUPABASE_URL=https://your-project.supabase.co

# Browser-safe key only: the publishable key, or the legacy anon key if the dashboard still shows that name.
# Do not use a secret key, a service_role key, or the database password.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public HTTPS origin of the deployed patient app, used inside slip QR codes.
# Example: https://sahaayopd.vercel.app
# Leave unset in local development to use the current browser origin.
# Do not include a trailing slash or /my-turn path.
# VITE_PUBLIC_APP_URL=https://your-deployed-app.example

# Edge Functions register-patient and get-my-turn use the project URL and service role
# from the Supabase platform environment. Do not put those secrets in Vite.

# Later voice agent identifiers. These are not an API key.
# VITE_SARVAM_ORG_ID=
# VITE_SARVAM_WORKSPACE_ID=
# VITE_SARVAM_APP_ID=

# Server only. Used by a future Vercel function, never by Vite.
# SARVAM_API_KEY=
